# Cisco UCCX 12.5 Informix Connection Settings
PORT=8080
UCCX_HOST=192.0.2.10
UCCX_PORT=1504
UCCX_SERVER=uccx_server_uccx
UCCX_DATABASE=db_cra
UCCX_USER=uccxwallboard
UCCX_PASSWORD=CHANGE_ME_UCCX_PASSWORD

# Wallboard Settings
REFRESH_INTERVAL_MS=10000
DEFAULT_CSQ=SALES
DEFAULT_TEAM=Default
DEFAULT_LANG=tr
MOCK_MODE=false

# Admin Panel Credentials (minimum 8 characters recommended)
ADMIN_USER=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
ADMIN_SESSION_TTL_MS=28800000

# Optional: Comma-separated allowed CORS origins (leave empty for same-origin only)
CORS_ORIGIN=
